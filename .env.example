# LiveKit Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# =====================
# Provider Selection
# =====================
# STT Provider: deepgram, openai, google, azure, assemblyai, sarvam
STT_PROVIDER=deepgram

# TTS Provider: deepgram, elevenlabs, openai, google, azure, cartesia
TTS_PROVIDER=deepgram

# LLM Provider: azure, gemini
LLM_PROVIDER=azure

# =====================
# Provider API Keys
# =====================

# Deepgram (STT + TTS)
DEEPGRAM_API_KEY=your_deepgram_key

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI (STT Whisper + TTS)
OPENAI_API_KEY=your_openai_key

# Azure OpenAI (LLM)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Speech (STT + TTS)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# Google/Gemini (LLM, STT, TTS)
GOOGLE_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-1.5-flash

# AssemblyAI (STT)
ASSEMBLYAI_API_KEY=your_assemblyai_key

# Cartesia (TTS - ultra low latency)
CARTESIA_API_KEY=your_cartesia_key

# Sarvam (STT - Indian languages support)
SARVAM_API_KEY=your_sarvam_key
SARVAM_MODEL=saarika:v2.5
SARVAM_LANGUAGE=en-IN

# =====================
# Twilio SIP Trunking (for outbound phone calls)
# =====================
# Step 1: Create Elastic SIP Trunk in Twilio Console
# Step 2: Configure Termination with credential auth
# Step 3: Create Outbound SIP Trunk in LiveKit Cloud dashboard
#         pointing to your-trunk.pstn.twilio.com
# Step 4: Copy the trunk ID here

SIP_OUTBOUND_TRUNK_ID=ST_your_trunk_id
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
